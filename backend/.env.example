# Limen Tourism Management Agent Environment Configuration
# Note: The backend currently loads LLM provider settings from backend/config.json
# (with fallback defaults in backend/app.py) and connects to backend/tourism.db.
# This template documents supported environment variables and operational parameters.

# LLM Provider Configuration (OpenAI-compatible gateway, e.g. Hermes / Antigravity)
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=
ACTIVE_MODEL=antigravity/gemini-3.8-flash-tiered

# External Data APIs
# - Open-Meteo Weather API (Live, no API key required): https://api.open-meteo.com/v1/forecast
# - Project OSRM Routing API (Live driving transit, no API key required): https://router.project-osrm.org/
# Optional/future provider placeholders (not currently wired into adapters):
GEOAPIFY_API_KEY=
TOMTOM_API_KEY=

# Application & Destination Defaults
DEMO_CITY=Visakhapatnam
DEMO_TIMEZONE=Asia/Kolkata
LIMEN_DB_PATH=tourism.db

# Data Mode: 'scenario' or 'live'
# Note: 'hybrid' is UNSUPPORTED and rejected by the runtime and UI mode selector.
# - scenario (default): Uses deterministic seeded database records for attractions, synthetic crowd readings,
#   accommodations inventory, and municipal service rules.
# - live: Calls live adapters (Open-Meteo weather, OSRM driving route) where supported;
#   unconnected feeds (real-time hotel bookings, sensor crowds) remain truthfully reported as UNKNOWN.
DATA_MODE=scenario
